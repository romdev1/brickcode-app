{
  "name": "brickcode-app",
  "version": "1.0.0",
  "description": "BrickCode App — приложение редактора BrickCode для LEGO EV3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "romdev1",
  "contributors": [
    "romdev1",
    "THEB0NNY (Dmitriy Antipov)",
    "Petteri Aimonen",
    "pxt-ev3-community"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "express": "^4.21.0",
    "adm-zip": "^0.5.16",
    "semver": "^7.6.3"
  },
  "build": {
    "appId": "org.brickcode.app",
    "productName": "BrickCode App",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "msi",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "signDlls": false,
      "sign": null
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BrickCode App"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BrickCode App"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": []
  }
}
